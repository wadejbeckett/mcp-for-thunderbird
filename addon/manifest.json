{
  "manifest_version": 3,
  "name": "MCP for Thunderbird",
  "version": "0.0.0",
  "description": "Lets MCP clients work with your mail through a local host, with limits you set in Thunderbird.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mcp-for-thunderbird@wadejbeckett.github.io",
      "strict_min_version": "153.0"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "MCP for Thunderbird",
    "default_popup": "ui/popup.html"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTagsList",
    "messagesImport",
    "messages.save",
    "compose",
    "addressBooks",
    "nativeMessaging",
    "storage"
  ],
  "optional_permissions": [
    "messages.send"
  ],
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  }
}
