{
  "manifest_version": 3,
  "name": "MCP for Thunderbird",
  "version": "0.0.0",
  "description": "Lets MCP clients work with your mail through a local host, with limits you set in Thunderbird.",
  "author": "Wade J. Beckett",
  "homepage_url": "https://github.com/wadejbeckett/mcp-for-thunderbird",
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mcp-for-thunderbird@wadejbeckett.github.io",
      "strict_min_version": "140.0"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "MCP for Thunderbird",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon.svg"
    },
    "default_popup": "ui/popup.html"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTagsList",
    "messagesImport",
    "compose",
    "scripting",
    "addressBooks",
    "nativeMessaging",
    "storage"
  ],
  "optional_permissions": [
    "messages.send"
  ],
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  }
}
