#
# Native-messaging hosts are registered per user, so the package cannot do
# it for everyone; it tells the user what to run instead.
set -e
if [ "$1" = "configure" ]; then
  echo 'Run `mcp-for-thunderbird setup` as your user'
  echo '(each user who runs Thunderbird with the MCP for Thunderbird add-on runs it once).'
fi
exit 0
